#include <configurations/virtioso/vm.h>

import <std_connector.camkes>;
import <global-connectors.camkes>;
import <Timer.idl4>;
import <seL4VMDTBPassthrough.idl4>;
import <FileServerInterface.camkes>;
import <FileServer/FileServer.camkes>;
import <GuestConsoleSink.camkes>;
import <ConsoleMux.camkes>;
import <VirtQueue/VirtQueue.camkes>;
import <vm-connectors.camkes>;
import <devices.camkes>;

component VM0 {
    VM_VIRTIOSO_INIT_DEF()

    VIRTIO_DRIVER_COMPONENT_DEF(1)
}

component VM1 {
    VM_VIRTIOSO_INIT_DEF()

    VIRTIO_DEVICE_COMPONENT_DEF(0)
}

assembly {
    composition {
        /* Boilerplate composition settings */
        VM_GENERAL_COMPOSITION_DEF()
        component ConsoleMux console_mux;
        component GuestConsoleSink vm0_guest_console_sink;
        component GuestConsoleSink vm1_guest_console_sink;

        /* Other standard VM definitions (vm0, vm1) */
        VM_COMPOSITION_DEF(0)
        VM_COMPOSITION_DEF(1)
        connection seL4SerialServer serial_input_vm0(from vm0.serial_getchar, to console_mux.vm0_getchar);
        connection seL4SerialServer serial_input_vm1(from vm1.serial_getchar, to console_mux.vm1_getchar);
        connection seL4RPCCall vm0_guest_console(from vm0.guest_putchar, to vm0_guest_console_sink.guest_putchar);
        connection seL4RPCCall vm1_guest_console(from vm1.guest_putchar, to vm1_guest_console_sink.guest_putchar);
        connection seL4SerialServer vm0_console_mux(from vm0.batch, to console_mux.mux_batch);
        connection seL4SerialServer vm1_console_mux(from vm1.batch, to console_mux.mux_batch);
        connection seL4SerialServer vm0_guest_console_sink_mux(from vm0_guest_console_sink.mux_batch, to console_mux.mux_batch);
        connection seL4SerialServer vm1_guest_console_sink_mux(from vm1_guest_console_sink.mux_batch, to console_mux.mux_batch);

        VIRTIO_COMPOSITION_DEF(0, 1)

        /* DTB Passthrough */
        connection seL4VMDTBPassthrough vm0_dtb(from vm0.dtb_self, to vm0.dtb);
        connection seL4VMDTBPassthrough vm1_dtb(from vm1.dtb_self, to vm1.dtb);
    }
    configuration {
        VM_GENERAL_CONFIGURATION_DEF()
        VM_VIRTIOSO_CONFIGURATION_DEF(0)
        VM_VIRTIOSO_CONFIGURATION_DEF(1)

        /* VM0 needs 80MB heap for LZ4 kernel decompression (~18MB compressed + ~51MB decompressed) */
        vm0.heap_size = 0x5000000;
        /* VM1 uses virtio-blk root, no kernel loading - default 3MB heap is sufficient */
        vm1.heap_size = 0x300000;

        vm0.num_extra_frame_caps = 0;
        vm0.extra_frame_map_address = 0;
        vm0.cnode_size_bits = 23;
        vm0.base_prio = 100;
        vm0._priority = 121;
        vm0.batch_shmem_size = 0x1000;
        vm0.serial_getchar_shmem_size = 0x1000;

        vm1.num_extra_frame_caps = 0;
        vm1.extra_frame_map_address = 0;
        vm1.cnode_size_bits = 23;

        vm1.base_prio = 100;
        vm1._priority = 101;
        vm1.batch_shmem_size = 0x1000;
        vm1.serial_getchar_shmem_size = 0x1000;
    }
}
