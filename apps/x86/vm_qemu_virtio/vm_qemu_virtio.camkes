#include <configurations/virtioso/vm.h>

import <std_connector.camkes>;
import <global-connectors.camkes>;
import <FileServerInterface.camkes>;
import <FileServer/FileServer.camkes>;
import <SerialServer/SerialServer.camkes>;
import <VM/vm.camkes>;
import <vm-connectors.camkes>;

#define VM0_GUEST_CMDLINE "earlyprintk=ttyS0,115200 console=ttyS0,115200 i8042.nokbd=y i8042.nomux=y " \
"i8042.noaux=y io_delay=udelay noisapnp pci=nomsi nolapic_timer debug " \
"loglevel=8 ignore_loglevel initcall_debug root=/dev/ram0 rdinit=/init"

#define VM1_GUEST_CMDLINE VM0_GUEST_CMDLINE

component Init0 {
    VM_VIRTIOSO_INIT_DEF()
    attribute string physical_pci_host_bridge;

    VIRTIO_DRIVER_COMPONENT_DEF(1)
}

component Init1 {
    VM_VIRTIOSO_INIT_DEF()

    VIRTIO_DEVICE_COMPONENT_DEF(0)
}

assembly {
    composition {
        VM_COMPOSITION_DEF()
        VM_PER_VM_COMP_DEF(0)
        VM_PER_VM_COMP_DEF(1)

        VIRTIO_COMPOSITION_DEF(0, 1)
    }

    configuration {
        VM_CONFIGURATION_DEF()
        VM_VIRTIOSO_CONFIGURATION_DEF(0)
        VM_VIRTIOSO_CONFIGURATION_DEF(1)

        vm0.simple_untyped23_pool = 21;
        vm0.simple_untyped22_pool = 1;
        vm0.heap_size = 0x5000000;
        vm0.iospace_domain = 0x0f;
        vm0.pci_devices_iospace = 1;
        vm1.heap_size = 0x300000;
        vm1.simple_untyped23_pool = 21;
        vm1.simple_untyped22_pool = 1;
        vm1.iospace_domain = 0x10;
        vm1.pci_devices_iospace = 2;
        vm0.guest_ram_mb = 128;
        vm1.guest_ram_mb = 128;

        vm0.kernel_cmdline = VM0_GUEST_CMDLINE;
        vm0.kernel_image = "bzimage";
        vm0.kernel_relocs = "bzimage";
        vm0.initrd_image = "rootfs.cpio.gz";
        vm0.physical_pci_host_bridge = "qemu_pc_q35";
        vm0.physical_pci_devices = [
            {
                "name": "q35-virtio-net",
                "owner": "guest",
                "bus": 0x00,
                "dev": 0x01,
                "fun": 0x0,
                "iospace": true,
                "interrupt_pin": 1
            },
            {
                "name": "q35-virtio-blk",
                "owner": "guest",
                "bus": 0x00,
                "dev": 0x02,
                "fun": 0x0,
                "iospace": true,
                "interrupt_pin": 1
            }
        ];
        vm0.untyped_mmios = [];
        vm0.vm_irqs = [];

        vm1.kernel_cmdline = VM1_GUEST_CMDLINE;
        vm1.kernel_image = "bzimage";
        vm1.kernel_relocs = "bzimage";
        vm1.initrd_image = "rootfs.cpio.gz";
        vm1.vm_irqs = [];
    }
}
