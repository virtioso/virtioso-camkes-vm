procedure CanBackend {
    include "can_backend_types.h";

    int start(void);
    int send(in can_backend_frame_t frame);
    int poll(out can_backend_frame_t frame);
    void get_state(out can_backend_state_t state);
    void get_snapshot(out kvaser_native_snapshot_t snapshot);
};
