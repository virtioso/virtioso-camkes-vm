#include <configurations/virtioso/vm.h>

import <std_connector.camkes>;
import <global-connectors.camkes>;
import <FileServerInterface.camkes>;
import <FileServer/FileServer.camkes>;
import <GuestConsoleSink.camkes>;
import <ConsolePassthroughSink.camkes>;
import <VM/vm.camkes>;
import <vm-connectors.camkes>;

#define VM0_GUEST_CMDLINE "earlyprintk=ttyS0,115200 console=ttyS0,115200 i8042.nokbd=y i8042.nomux=y " \
"i8042.noaux=y io_delay=udelay noisapnp pci=nomsi nolapic_timer initcall_blacklist=raid6_select_algo " \
"root=/dev/ram0 rdinit=/init"

#define VM1_GUEST_CMDLINE "earlyprintk=ttyS0,115200 console=ttyS0,115200 i8042.nokbd=y i8042.nomux=y " \
"i8042.noaux=y io_delay=udelay noisapnp pci=nomsi nolapic_timer initcall_blacklist=raid6_select_algo " \
"root=/dev/vda rw"

#define VM0_VM1_VIRTIO_DATA_BASE        0x9F000000
#define VM0_VM1_VIRTIO_DATA_SIZE        0x00800000
#define VM0_VM1_VIRTIO_CTRL_BASE        0xA0000000
#define VM0_VM1_VIRTIO_CTRL_SIZE        0x00080000

#define VM_GUEST_SINK_NAME(num) CAT(CAT(vm, num), _guest_console_sink)
#define VM_DIAG_SINK_NAME(num) CAT(CAT(vm, num), _vmm_diag_sink)

#undef VM_COMPOSITION_DEF
#define VM_COMPOSITION_DEF() \
    component FileServer fserv; \
    component ConsolePassthroughSink serial; \
    component GuestConsoleSink VM_GUEST_SINK_NAME(0); \
    component GuestConsoleSink VM_GUEST_SINK_NAME(1); \
    component GuestConsoleSink VM_DIAG_SINK_NAME(0); \
    component GuestConsoleSink VM_DIAG_SINK_NAME(1); \
    component GuestConsoleSink infra_diag_sink; \
    component PCIConfigIO pci_config; \
    component TimeServer time_server; \
    component RTC rtc; \
    connection seL4SerialServer vm0_guest_console_sink_uplink(from VM_GUEST_SINK_NAME(0).mux_batch, to serial.raw_batch); \
    connection seL4SerialServer vm1_guest_console_sink_uplink(from VM_GUEST_SINK_NAME(1).mux_batch, to serial.raw_batch); \
    connection seL4SerialServer vm0_vmm_diag_sink_uplink(from VM_DIAG_SINK_NAME(0).mux_batch, to serial.raw_batch); \
    connection seL4SerialServer vm1_vmm_diag_sink_uplink(from VM_DIAG_SINK_NAME(1).mux_batch, to serial.raw_batch); \
    connection seL4SerialServer infra_diag_sink_uplink(from infra_diag_sink.mux_batch, to serial.raw_batch); \
    connection seL4RPCCall serial_pci_config(from pci_config.putchar, to infra_diag_sink.guest_putchar); \
    connection seL4RPCCall serial_time_server(from time_server.putchar, to infra_diag_sink.guest_putchar); \
    connection seL4RPCCall serial_rtc(from rtc.putchar, to infra_diag_sink.guest_putchar); \
    /**/

#undef VM_PER_VM_CONNECTIONS
#define VM_PER_VM_CONNECTIONS(num) \
    connection seL4GlobalAsynch intreadycon##num(from vm##num.intready_connector, to vm##num.intready); \
    connection seL4RPCDataport fs##num(from vm##num.fs, to fserv.fs_ctrl); \
    connection seL4RPCCall serial_vm##num(from vm##num.putchar, to VM_DIAG_SINK_NAME(num).guest_putchar); \
    connection seL4RPCCall serial_guest_vm##num(from vm##num.guest_putchar, to VM_GUEST_SINK_NAME(num).guest_putchar); \
    connection seL4SerialServer serial_input##num(from vm##num.serial_getchar, to serial.getchar); \
    connection seL4RPCCall rtctest##num(from vm##num.system_rtc, to rtc.rtc); \
    connection seL4TimeServer CAT(pit##num,_timer)(from vm##num.init_timer, to time_server.the_timer); \
    connection seL4RPCCall pciconfig##num(from vm##num.pci_config, to pci_config.pci_config); \
    /**/

component Init0 {
    VM_VIRTIOSO_INIT_DEF()
    attribute string physical_pci_host_bridge;

    VIRTIO_DRIVER_COMPONENT_DEF(1)
}

component Init1 {
    VM_VIRTIOSO_INIT_DEF()

    VIRTIO_DEVICE_COMPONENT_DEF(0)
}

assembly {
    composition {
        VM_COMPOSITION_DEF()
        VM_PER_VM_COMP_DEF(0)
        VM_PER_VM_COMP_DEF(1)

        VIRTIO_COMPOSITION_DEF(0, 1)
    }

    configuration {
        VM_CONFIGURATION_DEF()
        VM_VIRTIOSO_CONFIGURATION_DEF(0)
        VM_VIRTIOSO_CONFIGURATION_DEF(1)
        VIRTIO_CONFIGURATION_DEF(0, 1)

        vm0.simple_untyped23_pool = 21;
        vm0.simple_untyped22_pool = 1;
        vm0.heap_size = 0x5000000;
        vm0.iospace_domain = 0x0f;
        vm0.pci_devices_iospace = 1;
        vm1.heap_size = 0x300000;
        vm1.simple_untyped23_pool = 21;
        vm1.simple_untyped22_pool = 1;
        vm1.iospace_domain = 0x10;
        vm1.pci_devices_iospace = 2;
        vm0.guest_ram_mb = 128;
        vm1.guest_ram_mb = 128;

        vm0.kernel_cmdline = VM0_GUEST_CMDLINE;
        vm0.kernel_image = "bzimage";
        vm0.kernel_relocs = "bzimage";
        vm0.initrd_image = "rootfs.cpio.gz";
        vm0.physical_pci_host_bridge = "qemu_pc_q35";
        vm0.physical_pci_devices = [
            {
                "name": "q35-virtio-net",
                "owner": "guest",
                "bus": 0x00,
                "dev": 0x01,
                "fun": 0x0,
                "iospace": true,
                "interrupt_pin": 1
            },
            {
                "name": "q35-virtio-blk",
                "owner": "guest",
                "bus": 0x00,
                "dev": 0x02,
                "fun": 0x0,
                "iospace": true,
                "interrupt_pin": 1
            }
        ];
        vm0.vm_virtio_device_channels = [
            VIRTIO_CHANNEL_DEVICE_CONFIGURATION_DEF(0, 1)
        ];
        vm0.untyped_mmios = [];
        vm0.vm_irqs = [];

        vm1.kernel_cmdline = VM1_GUEST_CMDLINE;
        vm1.kernel_image = "bzimage";
        vm1.kernel_relocs = "bzimage";
        vm1.initrd_image = "";
        vm1.vm_virtio_driver_channels = [
            VIRTIO_CHANNEL_DRIVER_CONFIGURATION_DEF(0, 1)
        ];
        vm1.vm_irqs = [];
    }
}
